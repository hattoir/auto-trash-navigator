<?xml version="1.0"?>
<!--
  SO-101 6軸アーム — Fusion 360 実測値版 (2026-07-28)

  リンク長: 全て前ジョイントからの +Z オフセット (CAD実測、単位 m)
    j1 0.04350 / j2 0.06445 / j3 0.10000 / j4 0.09755 / j5 0.04245 / j6 0.06855
    grasp(把持点) 0.07410 / tcp(指先) 0.08650   ※ベース底面からの全高 0.503 m
  回転軸: Z-X-X-Z-X-Z (j2 を正に回すとアームは +Y 方向へ倒れる / 右ねじ)
  可動域: サーボ+ホーン+ネジ込みの実測限界から安全側に設定
  質量・重心: PLA 1.24 g/cm3 + STS3215 55g/個 で算出した CAD 実測値
  effort/velocity: STS3215 のストール 1.9 N·m / 無負荷 4.4 rad/s に対する実用値
  慣性テンソル: リンク外形の円柱/直方体近似 (実測質量・重心を使用)

  注意: ゼロ姿勢 = 全関節 0 = 6軸すべてZ軸上に一直線 (真上)。
        実機組立後に各サーボへ Set Middle Position を打ち、機械ゼロ=2048=0rad を保証すること。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="so101_arm">

    <!-- ===== Joint 1 : ベース旋回 (Z) ===== -->
    <joint name="joint1" type="revolute">
      <parent link="arm_base_link"/>
      <child link="link1"/>
      <origin xyz="0 0 0.04350" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.05" upper="3.05" effort="0.6" velocity="2.2"/>
      <dynamics damping="0.5" friction="0.2"/>
    </joint>

    <link name="link1">
      <visual>
        <origin xyz="0 0 0.03223" rpy="0 0 0"/>
        <geometry><cylinder radius="0.030" length="0.06445"/></geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.03223" rpy="0 0 0"/>
        <geometry><cylinder radius="0.030" length="0.06445"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.0006 0 0.0339" rpy="0 0 0"/>
        <mass value="0.1476"/>
        <inertia ixx="${(1/12) * 0.1476 * (3*0.030*0.030 + 0.06445*0.06445)}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * 0.1476 * (3*0.030*0.030 + 0.06445*0.06445)}" iyz="0.0"
                 izz="${0.5 * 0.1476 * 0.030 * 0.030}"/>
      </inertial>
    </link>

    <!-- ===== Joint 2 : 肩ピッチ (X) ===== -->
    <!-- 2026-08-10: effortをモデル訂正。CAD実測に基づき、J2より先の
         質量598g・合成重心距離226mmから、腕が水平になる最悪ケースの
         重力トルクは 0.598kg * 9.81 * 0.226m ≈ 1.32 N・m と算出される。
         旧値 effort=0.6 はこれの45%しかなく自重すら支えられない
         (実際にGrasp姿勢近傍でjoint2が可動域限界に物理的に固着し、
         二度と戻れなくなる不具合の直接原因と特定済み)。
         実機サーボ STS3215 のストールトルクは1.9N・mであり、
         1.5N・m(必要1.32N・mの1.14倍、ストールの79%)は実機でも
         成立する範囲としてeffortを訂正する。 -->
    <joint name="joint2" type="revolute">
      <parent link="link1"/>
      <child link="link2"/>
      <origin xyz="0 0 0.06445" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.65" upper="1.65" effort="1.5" velocity="2.2"/>
      <dynamics damping="1.0" friction="0.4"/>
    </joint>

    <link name="link2">
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry><box size="0.036 0.032 0.100"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry><box size="0.036 0.032 0.100"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.0010 0 0.0666" rpy="0 0 0"/>
        <mass value="0.1232"/>
        <inertia ixx="${(1/12) * 0.1232 * (0.032*0.032 + 0.100*0.100)}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * 0.1232 * (0.036*0.036 + 0.100*0.100)}" iyz="0.0"
                 izz="${(1/12) * 0.1232 * (0.036*0.036 + 0.032*0.032)}"/>
      </inertial>
    </link>

    <!-- ===== Joint 3 : 肘ピッチ (X) ===== -->
    <!-- 2026-08-10: joint2と同じ理由でeffortをモデル訂正(重力
         モーメントを受けるピッチ軸)。J3より先の質量はJ2より先より
         小さいが、同じくSTS3215サーボ(ストール1.9N・m)を想定し、
         安全側にjoint2と同じ1.5N・mへ引き上げる。 -->
    <joint name="joint3" type="revolute">
      <parent link="link2"/>
      <child link="link3"/>
      <origin xyz="0 0 0.10000" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.66" upper="1.66" effort="1.5" velocity="2.2"/>
      <dynamics damping="0.8" friction="0.3"/>
    </joint>

    <link name="link3">
      <visual>
        <origin xyz="0 0 0.04878" rpy="0 0 0"/>
        <geometry><box size="0.032 0.028 0.09755"/></geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.04878" rpy="0 0 0"/>
        <geometry><box size="0.032 0.028 0.09755"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.0017 0 0.0592" rpy="0 0 0"/>
        <mass value="0.1197"/>
        <inertia ixx="${(1/12) * 0.1197 * (0.028*0.028 + 0.09755*0.09755)}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * 0.1197 * (0.032*0.032 + 0.09755*0.09755)}" iyz="0.0"
                 izz="${(1/12) * 0.1197 * (0.032*0.032 + 0.028*0.028)}"/>
      </inertial>
    </link>

    <!-- ===== Joint 4 : 前腕ロール (Z) ===== -->
    <joint name="joint4" type="revolute">
      <parent link="link3"/>
      <child link="link4"/>
      <origin xyz="0 0 0.09755" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.05" upper="3.05" effort="0.6" velocity="2.2"/>
      <dynamics damping="0.4" friction="0.15"/>
    </joint>

    <link name="link4">
      <visual>
        <origin xyz="0 0 0.02123" rpy="0 0 0"/>
        <geometry><cylinder radius="0.022" length="0.04245"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.02123" rpy="0 0 0"/>
        <geometry><cylinder radius="0.022" length="0.04245"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.0011 0 0.0283" rpy="0 0 0"/>
        <mass value="0.0811"/>
        <inertia ixx="${(1/12) * 0.0811 * (3*0.022*0.022 + 0.04245*0.04245)}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * 0.0811 * (3*0.022*0.022 + 0.04245*0.04245)}" iyz="0.0"
                 izz="${0.5 * 0.0811 * 0.022 * 0.022}"/>
      </inertial>
    </link>

    <!-- ===== Joint 5 : 手首ピッチ (X) ===== -->
    <!-- 2026-08-10: effortをモデル訂正。手首ピッチは先端側(link5,
         link6,グリッパー)のみを支えるため質量負荷はjoint2/3より
         小さいが、同様に重力モーメントを受けるピッチ軸であるため
         0.6 → 0.9 N・m(STS3215ストール1.9N・mの47%)へ引き上げる。 -->
    <joint name="joint5" type="revolute">
      <parent link="link4"/>
      <child link="link5"/>
      <origin xyz="0 0 0.04245" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.66" upper="1.66" effort="0.9" velocity="2.2"/>
      <dynamics damping="0.5" friction="0.2"/>
    </joint>

    <link name="link5">
      <visual>
        <origin xyz="0 0 0.03428" rpy="0 0 0"/>
        <geometry><box size="0.030 0.036 0.06855"/></geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.03428" rpy="0 0 0"/>
        <geometry><box size="0.030 0.036 0.06855"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.0021 0 0.0394" rpy="0 0 0"/>
        <mass value="0.0982"/>
        <inertia ixx="${(1/12) * 0.0982 * (0.036*0.036 + 0.06855*0.06855)}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * 0.0982 * (0.030*0.030 + 0.06855*0.06855)}" iyz="0.0"
                 izz="${(1/12) * 0.0982 * (0.030*0.030 + 0.036*0.036)}"/>
      </inertial>
    </link>

    <!-- ===== Joint 6 : 手首ロール (Z) ===== -->
    <joint name="joint6" type="revolute">
      <parent link="link5"/>
      <child link="link6"/>
      <origin xyz="0 0 0.06855" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.05" upper="3.05" effort="0.6" velocity="2.2"/>
      <dynamics damping="0.4" friction="0.15"/>
    </joint>

    <link name="link6">
      <visual>
        <origin xyz="0 0 0.0267" rpy="0 0 0"/>
        <geometry><cylinder radius="0.022" length="0.0534"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.0267" rpy="0 0 0"/>
        <geometry><cylinder radius="0.022" length="0.0534"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0.0120 0.0368" rpy="0 0 0"/>
        <mass value="0.1335"/>
        <inertia ixx="${(1/12) * 0.1335 * (3*0.022*0.022 + 0.0534*0.0534)}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * 0.1335 * (3*0.022*0.022 + 0.0534*0.0534)}" iyz="0.0"
                 izz="${0.5 * 0.1335 * 0.022 * 0.022}"/>
      </inertial>
    </link>

    <!-- ===== 手首カメラ (ELP基板) =====
         CAD実測: J6 から (0, +0.03745, +0.0804) m。基板が YZ 平面に立っており
         光軸は -Y (真横) を向く。ハンドアイとして使う場合は下記 rpy を
         見直すこと (把持点は +Z 側・カメラより手前にある)。 -->
    <joint name="wrist_camera_joint" type="fixed">
      <parent link="link6"/>
      <child link="wrist_camera_link"/>
      <origin xyz="0 0.03745 0.0804" rpy="0 0 0"/>
    </joint>

    <link name="wrist_camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.024 0.004 0.024"/></geometry>
        <material name="black"/>
      </visual>
    </link>

    <!-- 光学規約フレーム (Z前方・X右・Y下)。現状の光軸 -Y に対応 -->
    <joint name="wrist_camera_optical_joint" type="fixed">
      <parent link="wrist_camera_link"/>
      <child link="wrist_camera_optical_link"/>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </joint>
    <link name="wrist_camera_optical_link"/>

    <!-- ===== 把持点 / 指先 (IKの目標に使う) =====
         grasp_link  : 把持面の中心 (J6 から +0.07410) ← MoveIt の目標はここ
         tcp_link    : 指先端        (J6 から +0.08650) -->
    <joint name="grasp_joint" type="fixed">
      <parent link="link6"/>
      <child link="grasp_link"/>
      <origin xyz="0 0 0.07410" rpy="0 0 0"/>
    </joint>
    <link name="grasp_link"/>

    <joint name="tcp_joint" type="fixed">
      <parent link="link6"/>
      <child link="tcp_link"/>
      <origin xyz="0 0 0.08650" rpy="0 0 0"/>
    </joint>
    <link name="tcp_link"/>

    <!-- 自己干渉設定 -->
    <gazebo reference="link1"><self_collision>false</self_collision></gazebo>
    <gazebo reference="link2"><self_collision>false</self_collision></gazebo>
    <gazebo reference="link3"><self_collision>false</self_collision></gazebo>

  </xacro:macro>

</robot>

<?xml version="1.0"?>
<robot name="visual_amr" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <material name="silver"><color rgba="0.700 0.700 0.700 1.000"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <link name="base_footprint"/>

  <!-- 2026-08-24 実機HW確定(feature/hw-v2): base_link原点高さ(z)の算出根拠。
       確定仕様(base_footprint基準): 車輪半径0.040 / 主板上面z=0.060。
       base_linkを主板の板厚を表す薄い箱とし、下面=車輪中心高さ(接地条件、
       車輪半径と一致=0.040)、上面=主板上面(0.060)となるように定義する。
         板厚 = 0.060 - 0.040 = 0.020
         base_link原点(中心)z = (0.040 + 0.060) / 2 = 0.050
       この結果、子リンク(車輪, arm_base, oak_d, lidar)のjoint origin zは
       「絶対値(base_footprint基準) - 0.050」で算出する。
       検算: 旧値(base_link z=0.1, 板厚0.15)は 底面=0.025 上面=0.175 で
       あり、旧arm_base_joint z=0.075→arm_base_link絶対z=0.175。
       新: 底面=0.040(旧0.025から車輪半径分上昇)上面=0.060。 -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.050" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.4 0.02"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><box size="0.4 0.4 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="${(1/12) * 10.0 * (0.4*0.4 + 0.02*0.02)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * 10.0 * (0.4*0.4 + 0.02*0.02)}" iyz="0.0"
               izz="${(1/12) * 10.0 * (0.4*0.4 + 0.4*0.4)}"/>
    </inertial>
  </link>

  <!-- Include and invoke 4-wheel omni base macro -->
  <xacro:include filename="base_omni_4wheel.xacro"/>
  <xacro:base_omni_4wheel/>

  <!-- 2026-08-24 実機HW確定: OAK-D Lite 光学中心 (0.182, 0.135, 0.197)
       [base_footprint基準]、俯角25°。oak_d_optical_joint(下記、Z前方の
       光学フレーム規約)は並進0のため、oak_d_link原点=光学中心の絶対位置
       をそのままbase_link基準に変換すればよい: z = 0.197 - 0.050 = 0.147。
       pitch = 25° = 0.4363323 rad(既存符号規約=正のpitchで下向きを踏襲)。 -->
  <joint name="oak_d_joint" type="fixed">
    <parent link="base_link"/>
    <child link="oak_d_link"/>
    <origin xyz="0.182 0.135 0.147" rpy="0 0.4363323 0"/>
  </joint>

  <link name="oak_d_link">
    <visual>
      <geometry><box size="0.03 0.1 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="${(1/12) * 0.15 * (0.1*0.1 + 0.03*0.03)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * 0.15 * (0.03*0.03 + 0.03*0.03)}" iyz="0.0"
               izz="${(1/12) * 0.15 * (0.03*0.03 + 0.1*0.1)}"/>
    </inertial>
  </link>

  <joint name="oak_d_optical_joint" type="fixed">
    <parent link="oak_d_link"/>
    <child link="oak_d_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>
  <link name="oak_d_optical_link"/>

  <!-- 2026-08-24 実機HW確定: RPLIDAR A1M8。スキャン面z=0.210、
       位置x=-0.160,y=+0.013 [base_footprint基準] → base_link基準は
       z=0.210-0.050=0.160。取付都合で本体を90°回しているため
       laser_frameにyaw+90°を付与(除去角度セクターの算出根拠は
       lidar_filter.pyのコメント参照)。 -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.160 0.013 0.160" rpy="0 0 1.5707963"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="${(1/12) * 0.1 * (3*0.03*0.03 + 0.03*0.03)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * 0.1 * (3*0.03*0.03 + 0.03*0.03)}" iyz="0.0"
               izz="${0.5 * 0.1 * 0.03 * 0.03}"/>
    </inertial>
  </link>

  <!-- 2026-08-24 実機HW確定: アーム取付 x=0.150,y=0,z=主板上面(0.060)
       [base_footprint基準、Ø100フランジ] → base_link基準は
       z=0.060-0.050=0.010。向き(rpy)は現状維持(J2正転で車体前方=+X
       へ倒れる設計を保つためyaw+90°のまま)。 -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.150 0 0.010" rpy="0 0 1.5707963"/>
  </joint>

  <link name="arm_base_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="${(1/12) * 0.5 * (3*0.05*0.05 + 0.04*0.04)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * 0.5 * (3*0.05*0.05 + 0.04*0.04)}" iyz="0.0"
               izz="${0.5 * 0.5 * 0.05 * 0.05}"/>
    </inertial>
  </link>

  <!-- Include and invoke SO-101 arm macro -->
  <xacro:include filename="so101_arm.xacro"/>
  <xacro:so101_arm/>

  <!-- Include and invoke parallel gripper macro -->
  <xacro:include filename="gripper.xacro"/>
  <xacro:so101_gripper/>

  <!-- Self collision settings for base_link -->
  <gazebo reference="base_link">
    <self_collision>false</self_collision>
  </gazebo>

  <!-- ros2_control configuration for arm and gripper -->
  <ros2_control name="amr_robot_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- Arm Joints -->
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Gripper Joints -->
    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- right_finger_joint mimics left_finger_joint (see gripper.xacro);
         mimic joints must not declare a command_interface (gz_ros2_control
         rejects "Activated mimic joints cannot have command interfaces"). -->
    <joint name="right_finger_joint">
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Sim ros2_control plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find amr_description)/config/amr_controllers.yaml</parameters>
      <hold_joints>false</hold_joints>
      <position_proportional_gain>1000.0</position_proportional_gain>
    </plugin>
  </gazebo>


  <!-- IMU Sensor -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
    </sensor>
  </gazebo>

  <!-- OAK-D RGB-D Camera Sensor -->
  <gazebo reference="oak_d_link">
    <sensor name="oakd_camera" type="rgbd">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.25</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <topic>camera</topic>
    </sensor>
  </gazebo>

  <!-- 360 Degree 2D LiDAR Sensor -->
  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>/lidar</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- 2026-08-24: 実機HW確定でLiDAR-アーム基部間距離が0.31m(伸展時0.51m)に
               広がり、min rangeだけではアーム除去に不十分(伸ばしたアームがrange外に
               出てしまう)。センサー側のminは仕様値0.15のみとし、アーム自己ヒットの
               除去はlidar_filter.pyの角度セクターフィルタで行う。 --><min>0.15</min>
          <max>12.0</max>
        </range>
      </lidar>
      <gz_frame_id>lidar_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Gazebo Sim Sensor Plugins -->
  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>
</robot>

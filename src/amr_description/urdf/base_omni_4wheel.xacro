<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <!-- Macro for a single omni wheel -->
  <!-- 2026-08-24 実機HW確定(feature/hw-v2): wheel Ø80mm(半径0.040)、
       ホイールベース240mm/トレッド360mm → 車輪位置 x=±0.120, y=±0.180。
       z=-0.010 は base_link 原点(z=0.050, base_footprint基準)から
       車輪中心(=車輪半径0.040, 接地条件)までのオフセット
       (0.040 - 0.050 = -0.010)。base_linkのz算出根拠は
       amr_robot.urdf.xacro の base_joint コメント参照。
       joint速度上限 16.0 rad/s は 最高速度0.64m/s ÷ 半径0.040 = 16.0 -->
  <xacro:macro name="omni_wheel" params="prefix x_reflect y_reflect fdir">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect * 0.120} ${y_reflect * 0.180} -0.010" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" velocity="16.0"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.040" length="0.04"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.040"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="${(1/12) * 0.2 * (3 * 0.040 * 0.040 + 0.04 * 0.04)}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * 0.2 * (3 * 0.040 * 0.040 + 0.04 * 0.04)}" iyz="0.0"
                 izz="${0.5 * 0.2 * 0.040 * 0.040}"/>
      </inertial>
    </link>

    <gazebo reference="${prefix}_wheel_link">
      <self_collision>false</self_collision>
      <collision name="${prefix}_wheel_link_collision">
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_footprint">${fdir}</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e7</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <!-- Macro to add 4 omni wheels -->
  <xacro:macro name="base_omni_4wheel">
    <xacro:omni_wheel prefix="front_left" x_reflect="1" y_reflect="1" fdir="1 -1 0"/>
    <xacro:omni_wheel prefix="front_right" x_reflect="1" y_reflect="-1" fdir="-1 -1 0"/>
    <xacro:omni_wheel prefix="rear_left" x_reflect="-1" y_reflect="1" fdir="1 1 0"/>
    <xacro:omni_wheel prefix="rear_right" x_reflect="-1" y_reflect="-1" fdir="-1 1 0"/>

    <!-- 2026-09-01 実機HW確定(feature/diff-drive): モータードライバが
         MD10C(1ch)x2しか確保できず、4ch必要なメカナム独立駆動が不可能に
         なったため、左右ペア並列駆動の差動2輪に変更(FL+RL / FR+RR)。
         車輪自体は物理的にメカナムのまま(コリジョン形状・異方性摩擦・
         軸極性は無変更、上のomni_wheelマクロ参照)。左右ペアが機械的に
         同期することでvy=0に拘束され、結果として差動2輪と等価になる。
         4輪すべてleft_joint/right_jointに登録する(FL/FRだけ登録すると
         後輪が無動力になり、左右ペアが並列駆動される実機と挙動が異なる
         ため。gz-sim-diff-drive-systemは複数joint登録に対応しており、
         登録した全jointへ同じ左右コマンドを送る。参照実装:
         /opt/ros/jazzy/opt/gz_sim_vendor/share/gz/gz-sim8/worlds/
         skid_steer_mecanum.sdf も同様に4joint(前後左右)を
         left_joint/right_jointへ登録している)。
         最高速度0.45m/s・最大角速度2.5rad/sはプラグインの
         max_linear_velocity/max_angular_velocityで直接クランプする
         (車輪joint自体の速度上限16.0rad/sは変更しない指示のため維持。
         0.45m/s+2.5rad/s同時最大時は車輪面速度換算で22.5rad/sとなり
         16.0rad/s上限で物理的にクリップされ得るが、これは同時最大操作
         という稀なケースでの上限飽和であり、単独の並進0.45m/s
         (=11.25rad/s)・単独の旋回2.5rad/s(=11.25rad/s)はいずれも
         16.0rad/s以内に収まる)。
         odom/tf設定はMecanumDrive時と同一(publish_odom_tf=false等)を
         維持。 -->
    <gazebo>
      <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>0.360</wheel_separation>
        <wheel_radius>0.040</wheel_radius>
        <max_linear_velocity>0.45</max_linear_velocity>
        <min_linear_velocity>-0.45</min_linear_velocity>
        <max_angular_velocity>2.5</max_angular_velocity>
        <min_angular_velocity>-2.5</min_angular_velocity>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
